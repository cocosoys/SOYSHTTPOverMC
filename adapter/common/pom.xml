<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      =====================================================================
      SOYSHTTPOverMC · 版本兼容模块 · 公共底座（adapter/common）
      =====================================================================
      定位：所有版本适配模块（adapter/v1_6x、adapter/v1_7x…）共享的「统一规范 + 公共代码」。
      职责：
        1. 定义统一包结构 / 命名 / 构建基线（见 README.md 统一规范）；
        2. 提供版本中立兼容工具（ServerVersion / BukkitCompat / ChatCompat / PlayerIdentity）；
        3. 定义版本模块必须实现的 SPI 契约（AdapterActivator / SocketSnifferAdapter）。

      编译基线（重要）：
        本模块【零 Bukkit 编译期依赖】——不 import 任何 org.bukkit.*，不 vendored 任何
        craftbukkit jar；所有对 Bukkit 的调用一律通过反射（Class.forName + Method.invoke）
        完成，保证所有低版本模块（v1_6x / v1_7x…）复用本模块产物时不受任何版本 API 约束。
        具体版本差异仍由各版本模块在自身（保留 craftbukkit 编译期依赖）内处理。

      依赖说明：
        - 主工程 common（仅编译期）：用于统一日志门面（@CustomLog → LogKit）与 Platform SPI 等
          基础能力。仅编译依赖，不打入本模块产物（产物仍保持轻量）。
    -->
    <parent>
        <groupId>com.github.cocosoys.mc</groupId>
        <artifactId>soyshttpovermc-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>soyshttpovermc-adapter-common</artifactId>
    <packaging>jar</packaging>
    <name>SOYSHTTPOverMC Adapter Common</name>
    <description>版本兼容模块公共底座：统一规范 + 版本中立兼容工具（零 Bukkit 编译期依赖，全部反射）+ 版本模块 SPI 契约</description>

    <dependencies>

        <!-- 主工程 common（统一日志门面 LogKit / Platform SPI 等；仅编译期，不打入本模块产物） -->
        <dependency>
            <groupId>com.github.cocosoys.mc</groupId>
            <artifactId>soyshttpovermc-common</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
