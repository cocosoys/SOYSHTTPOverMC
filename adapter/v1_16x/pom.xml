<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      =====================================================================
      SOYSHTTPOverMC · 高版本兼容模块 · 1.16.x（adapter/v1_16x，目标 1.16.5）
      =====================================================================
      职责：为 1.16.x 服务器提供版本特化适配：
        1. Platform 覆盖（继承 core PlatformBukkitImpl）；
        2. AdapterActivator 激活入口（ServiceLoader 注册，由 adapter/common 的 AdapterActivators 发现）；
        3. SocketSnifferAdapter 版本桥（1.16.x 使用 io.netty（非 relocate），
           NMS 包为 v1_16_R3，ServerConnection 经 getServerConnection() 方法定位）。

      编译基线：Java 11（用户指定；1.16.5 服务端可运行于 Java 8/11，本模块用 Java 11
        编译以解锁更高字节码特性，运行期向下兼容 Java 8 服务端需注意不使用 Java 9+ API）。
        通过 maven-toolchains-plugin 强制使用 toolchains.xml 中注册的 JDK 11。

      打包产物：本模块 shade 出【完整 fat jar】（adapter-common + soyshttpovermc-common +
        soyshttpovermc-core + 本模块实现 + META-INF/services 合并 + 本模块 plugin.yml 覆盖），
        可直接放入 1.16.x 服务器 plugins/ 运行。

      plugin.yml api-version：标注为 1.13（1.13+ 引入的现代插件 API 声明，1.16 服务端接受，
        使插件走现代事件/材料 API 路径，避免 legacy 兼容层开销）。
    -->
    <parent>
        <groupId>com.github.cocosoys.mc</groupId>
        <artifactId>soyshttpovermc-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>soyshttpovermc-adapter-v1_16x</artifactId>
    <packaging>jar</packaging>
    <name>SOYSHTTPOverMC Adapter v1.16.x</name>
    <description>1.16.x 版本兼容模块（目标 1.16.5）：Platform 覆盖 + 激活器 + SocketSniffer 版本桥；Java 11 编译；api-version 1.13</description>

    <properties>
        <!-- 覆盖父工程默认 Java 8 → 本模块强制 Java 11 -->
        <java.version>11</java.version>
        <adapter.api.version>1.16.5-R0.1-SNAPSHOT</adapter.api.version>
        <!-- plugin.yml 中注入的 api-version（经 resource filtering 替换） -->
        <plugin.api.version>1.13</plugin.api.version>
    </properties>

    <dependencies>
        <!-- 公共底座（SPI 契约 + ServerVersion + compat 工具） -->
        <dependency>
            <groupId>com.github.cocosoys.mc</groupId>
            <artifactId>soyshttpovermc-adapter-common</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 主工程 common（Platform SPI / ConfigSection / Platforms）；shade 打入最终 fat jar -->
        <dependency>
            <groupId>com.github.cocosoys.mc</groupId>
            <artifactId>soyshttpovermc-common</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 主工程 core（继承 PlatformBukkitImpl 等默认实现；全部逻辑 + resources 经 shade 打入最终 fat jar） -->
        <dependency>
            <groupId>com.github.cocosoys.mc</groupId>
            <artifactId>soyshttpovermc-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <!--
          目标版本 spigot-api（仅编译期；运行期由服务端提供）。
          从 spigot-repo 公共仓库解析，含 Bukkit API 接口；
          NMS 类经运行期反射访问，无需编译期引用。
        -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>${adapter.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <!--
          1.16.x 服务端已使用 io.netty（非 relocate，1.7 时代的 net.minecraft.util.io.netty 已废弃），
          netty-all 由服务端提供，scope=provided 即可，无需 runtime 内嵌。
        -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- ORM SQL 后端依赖：HikariCP / slf4j-api 随 fat jar 内嵌 -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>SOYSHTTPOverMC-1_16-${project.version}</finalName>
        <resources>
            <!-- plugin.yml 开启 filtering，注入 ${project.version} 和 ${plugin.api.version} -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <!-- 其余资源（META-INF/services 等）不 filtering -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!-- 强制 Java 11 编译（覆盖父工程默认 1.8） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <!-- 通过 toolchains 锁定 JDK 11（toolchains.xml 已注册 D:\WorkTools\JDK\11） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>toolchain</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <toolchains>
                        <jdk>
                            <version>11</version>
                        </jdk>
                    </toolchains>
                </configuration>
            </plugin>
            <!--
              版本完整 fat jar：把 adapter-common + soyshttpovermc-common + soyshttpovermc-core
              （全部类 + resources + META-INF/services）打进本模块。
              本模块自带的 plugin.yml 会覆盖 core 中的同名资源（shade 时后加载的覆盖先加载的，
              本模块在 dependency 顺序中位于 core 之后，故本模块 plugin.yml 胜出）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>SOYSHTTPOverMC-1_16-${project.version}</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 打包后将 shaded 产物复制到项目根 output/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-to-output</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete failonerror="false">
                                    <fileset dir="${project.basedir}/../../output">
                                        <include name="SOYSHTTPOverMC-1_16-${project.version}.jar"/>
                                    </fileset>
                                </delete>
                                <copy todir="${project.basedir}/../../output" failonerror="false">
                                    <fileset dir="${project.build.directory}">
                                        <include name="SOYSHTTPOverMC-1_16-${project.version}.jar"/>
                                    </fileset>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
