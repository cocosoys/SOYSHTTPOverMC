<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      =====================================================================
      SOYSHTTPOverMC · 版本兼容模块 · 1.7.x（adapter/v1_7x，目标 1.7.10）
      =====================================================================
      职责：为 1.7.10 服务器提供版本特化适配：
        1. Platform 覆盖（继承 core PlatformBukkitImpl；YAML UTF-8 由本模块 V1_7YamlIo 自实现，
           在 V1_7PlatformAdapter 覆写 loadYaml/saveYaml 接入）；
        2. AdapterActivator 激活入口（ServiceLoader 注册，由 adapter/common 的 AdapterActivators 发现）；
        3. SocketSnifferAdapter 版本桥（1.7.10 已引入 Netty，可同端口嗅探；
           经「方法名+字段类型」双通道反射解析 v1_7_R4 的 ServerConnection）。

      编译基线：craftbukkit-1.7.10（vendored 于 adapter/v1_7x/lib/，system scope 仅编译期）。
      打包产物：本模块 shade 出【完整 fat jar】（adapter-common + soyshttpovermc-common +
        soyshttpovermc-core + 本模块实现 + META-INF/services 合并），可直接放入 1.7.10
        服务器 plugins/ 运行；craftbukkit 由服务端提供、不打入。
    -->
    <parent>
        <groupId>com.github.cocosoys.mc</groupId>
        <artifactId>soyshttpovermc-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>soyshttpovermc-adapter-v1_7x</artifactId>
    <packaging>jar</packaging>
    <name>SOYSHTTPOverMC Adapter v1.7.x</name>
    <description>1.7.x 版本兼容模块（目标 1.7.10）：Platform 覆盖 + 激活器 + SocketSniffer 版本桥</description>

    <properties>
        <adapter.api.version>1.7.10-R0.1-SNAPSHOT</adapter.api.version>
        <!-- 自包含 vendored API（本模块 lib/ 下），避免依赖外部共享目录 -->
        <adapter.lib.dir>${project.basedir}/lib</adapter.lib.dir>
    </properties>

    <dependencies>
        <!-- 公共底座（SPI 契约 + ServerVersion + compat 工具） -->
        <dependency>
            <groupId>com.github.cocosoys.mc</groupId>
            <artifactId>soyshttpovermc-adapter-common</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 主工程 common（Platform SPI / ConfigSection / Platforms）；shade 打入最终 fat jar -->
        <dependency>
            <groupId>com.github.cocosoys.mc</groupId>
            <artifactId>soyshttpovermc-common</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 主工程 core（继承 PlatformBukkitImpl 等默认实现；全部逻辑 + resources 经 shade 打入最终 fat jar） -->
        <dependency>
            <groupId>com.github.cocosoys.mc</groupId>
            <artifactId>soyshttpovermc-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 目标版本 craftbukkit API（仅编译期；运行期由服务端提供） -->
        <dependency>
            <groupId>org.bukkit</groupId>
            <artifactId>craftbukkit</artifactId>
            <version>${adapter.api.version}</version>
            <scope>system</scope>
            <systemPath>${adapter.lib.dir}/craftbukkit-1.7.10.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <!--
          ORM SQL 后端依赖：HikariCP / slf4j-api 服务端（craftbukkit）无，需随 fat jar
          内嵌。本模块为 JDK8 环境（目标服务端 1.7.10/1.6.4 JDK8），直接以 JDK8 字节码
          打包，无需 build_java7.py 转译（与 v1_6xJava7 不同）。
        -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
          netty-all 4.1.24（版本由根 pom dependencyManagement 管理）：1.7.10 服务端的 netty
          为 relocate 版（net.minecraft.util.io.netty.*），无 io.netty.* 可用。core 的
          NettyEventLoopRequestHandler 在 http-backend.mode=netty-eventloop（默认）时 new
          NioEventLoopGroup 需要 io.netty，故以 runtime scope 随 fat jar 内嵌，解锁低版本
          netty-eventloop 后端模式。同端口探测仍走本模块反射桥（relocate netty），不受影响。
        -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>SOYSHTTPOverMC-1_7-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <!--
              版本完整 fat jar：把 adapter-common + soyshttpovermc-common + soyshttpovermc-core
              （全部类 + resources + META-INF/services）打进本模块，产出可直接部署的完整插件 jar。
              craftbukkit-1.7.10 为 system scope 不打入（运行期由 1.7.10 服务端提供）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>SOYSHTTPOverMC-1_7-${project.version}</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 打包后将 shaded 产物复制到项目根 output/（便于直接取用） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-to-output</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete failonerror="false">
                                    <fileset dir="${project.basedir}/../../output">
                                        <include name="SOYSHTTPOverMC-1_7-${project.version}.jar"/>
                                    </fileset>
                                </delete>
                                <copy todir="${project.basedir}/../../output" failonerror="false">
                                    <fileset dir="${project.build.directory}">
                                        <include name="SOYSHTTPOverMC-1_7-${project.version}.jar"/>
                                    </fileset>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
