<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      =====================================================================
      SOYSHTTPOverMC · 高版本兼容模块 · 1.20.x（adapter/v1_20x，目标 1.20.4）
      =====================================================================
      职责：为 1.20.x 服务器提供版本特化适配：
        1. Platform 覆盖（继承 core PlatformBukkitImpl）；
        2. AdapterActivator 激活入口（ServiceLoader 注册）；
        3. SocketSnifferAdapter 版本桥（1.20.x NMS 无版本包前缀，
           ServerConnection 位于 net.minecraft.server.network，
           1.20.5+ 改名为 ServerConnectionListener —— 本模块目标 1.20.4 仍为 ServerConnection）。

      编译基线：Java 17（1.18~1.20.4 服务端最低要求 Java 17）。
        通过 maven-toolchains-plugin 强制使用 toolchains.xml 中注册的 JDK 17。

      打包产物：完整 fat jar，可直接放入 1.20.x 服务器 plugins/ 运行。

      plugin.yml api-version：标注为 1.20（与目标版本对齐，启用现代 API 路径）。

      注意：1.20.5+ 存在破坏性变更（PacketSplitter→Varint21FrameDecoder、
        ServerConnection→ServerConnectionListener、Java 21、材料/注册表重构），
        需单独模块 v1_20_5 适配，不在本模块范围内。
    -->
    <parent>
        <groupId>com.github.cocosoys.mc</groupId>
        <artifactId>soyshttpovermc-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>soyshttpovermc-adapter-v1_20x</artifactId>
    <packaging>jar</packaging>
    <name>SOYSHTTPOverMC Adapter v1.20.x</name>
    <description>1.20.x 版本兼容模块（目标 1.20.4）：Platform 覆盖 + 激活器 + SocketSniffer 版本桥；Java 17 编译；api-version 1.20</description>

    <properties>
        <!-- 覆盖父工程默认 Java 8 → 本模块强制 Java 17 -->
        <java.version>17</java.version>
        <adapter.api.version>1.20.4-R0.1-SNAPSHOT</adapter.api.version>
        <!-- plugin.yml 中注入的 api-version -->
        <plugin.api.version>1.20</plugin.api.version>
    </properties>

    <dependencies>
        <!-- 公共底座（SPI 契约 + ServerVersion + compat 工具） -->
        <dependency>
            <groupId>com.github.cocosoys.mc</groupId>
            <artifactId>soyshttpovermc-adapter-common</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 主工程 common -->
        <dependency>
            <groupId>com.github.cocosoys.mc</groupId>
            <artifactId>soyshttpovermc-common</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 主工程 core -->
        <dependency>
            <groupId>com.github.cocosoys.mc</groupId>
            <artifactId>soyshttpovermc-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <!--
          目标版本 spigot-api（仅编译期；运行期由服务端提供）。
          从 spigot-repo 公共仓库解析，含 Bukkit API 接口；
          NMS 类经运行期反射访问，无需编译期引用。
          注意：1.20.5+ 存在破坏性变更（ServerConnection→ServerConnectionListener 等），
          需单独模块适配，不在本模块范围内。
        -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>${adapter.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <!-- 1.20.x 服务端使用 io.netty（非 relocate），由服务端提供 -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- ORM SQL 后端依赖 -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>SOYSHTTPOverMC-1_20-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!-- 强制 Java 17 编译 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <!-- 通过 toolchains 锁定 JDK 17 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>toolchain</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <toolchains>
                        <jdk>
                            <version>17</version>
                        </jdk>
                    </toolchains>
                </configuration>
            </plugin>
            <!-- 完整 fat jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>SOYSHTTPOverMC-1_20-${project.version}</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 打包后复制到 output/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-to-output</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete failonerror="false">
                                    <fileset dir="${project.basedir}/../../output">
                                        <include name="SOYSHTTPOverMC-1_20-${project.version}.jar"/>
                                    </fileset>
                                </delete>
                                <copy todir="${project.basedir}/../../output" failonerror="false">
                                    <fileset dir="${project.build.directory}">
                                        <include name="SOYSHTTPOverMC-1_20-${project.version}.jar"/>
                                    </fileset>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
